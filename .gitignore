# ============================================================================
# .gitignore da raiz — cobre o monorepo inteiro (Node + Terraform + sistema).
# ============================================================================

# ---------- Node / aplicação ----------
node_modules/
**/node_modules/
app/client/dist/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
.vite/
*.timestamp-*.mjs

# Variáveis de ambiente da aplicação
.env
.env.*
!.env.example

# ---------- Terraform ----------
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
*.tfvars
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl

# ---------- Artefatos de build/deploy ----------
*.zip
mercantis-app.zip

# ---------- Sistema operacional / editores ----------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
